{
 "scripts": {
  "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm migration:generate -- -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "seed": "tsx src/seeds/seed.ts"
 },
 "devDependencies": {
  "@types/bcrypt": "^6.0.0",
  "@types/cors": "^2.8.19",
  "@types/express": "^5.0.6",
  "@types/uuid": "^10.0.0",
  "tsx": "^4.23.15"
 },
 "dependencies": {
  "bcrypt": "^6.0.0",
  "cors": "^2.8.6",
  "dotenv": "^18.0.10",
  "express": "^5.3.0",
  "express-rate-limit": "^8.7.4",
  "helmet": "^8.3.0",
  "joi": "^18.3.2",
  "mysql2": "^3.24.6",
  "typeorm": "^1.1.3",
  "uuid": "^14.0.3",
  "winston": "^3.19.0"
 }
}
